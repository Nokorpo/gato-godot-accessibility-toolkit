script = ExtResource("1_1q2hi")
next_sequence = 1
sequence_script = "SAY \"Gato: Hola me llamo Gato y me han robado las bellotas\"
STOP
PLAY_ANIMATION gato_hit
SET_HP gato 50
STOP
SAY \"Zeta: Soy Zeta y le he robado las bellotas\"
PLAY_ANIMATION zeta_risa
STOP
SAY \"¡Ayúdame a recuperar mis bellotas!\"
STOP"
