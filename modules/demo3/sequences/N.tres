sequence_script = "PLAY_ANIMATION gato_talk
SAY Gato: \"¿Cómo tienes la poca decencia de dejar a este pequeño sin su comida?\"
STOP
PLAY_ANIMATION zeta_angry
SAY Zeta: \"¿¡Eh!? ¿E-estoy sintiendo... culpa?\"
STOP
PLAY_ANIMATION zeta_hit
SET_HP zeta 20
SAY Es muy eficaz. Zeta perdió un 40% de sus puntos de moral.
STOP
"
